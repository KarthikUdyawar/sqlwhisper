# SQLWhisper — environment variables template
#
# Copy to one of:
#   .env.development   (local dev)
#   .env.staging       (staging deploy)
#   .env.production    (production deploy)
#
# Then fill in real values.  NEVER commit a filled-in .env* file.
#
# Which file is loaded is controlled by APP_ENV (default: development).
# A plain .env is always loaded as a base fallback.
#
# Secrets (DB URLs with passwords, API keys) MUST live here — not config.yaml.
# Non-secret tunables (timeouts, model names) live in config/config.yaml.
#
# Env var format: SQLWHISPER_<SECTION>__<KEY>
#   Single underscore after the prefix (SQLWHISPER_), then double-underscore
#   as the nested delimiter (__) between section and key.

# ── Environment ──────────────────────────────────────────────────────────────
APP_ENV="development"   # development | staging | production

# ── Database URLs (secrets — contain credentials) ────────────────────────────
# Pattern: SQLWHISPER_DATABASES__<ALIAS>__URL
# Each alias here also needs a matching `databases.<alias>.dialect` entry in
# config/config.yaml — dialect is non-secret and is NOT read from .env.
SQLWHISPER_DATABASES__DEFAULT__URL="postgresql://user:password@localhost:5432/mydb"
SQLWHISPER_DATABASES__LOCAL__URL=sqlite:///./dev.db

# ── Ollama overrides (optional — defaults in config.yaml are usually fine) ───
# SQLWHISPER_OLLAMA__BASE_URL="http://localhost:11434"
# SQLWHISPER_OLLAMA__MODEL="sqlcoder:7b"
# SQLWHISPER_OLLAMA__TIMEOUT_SECONDS="30"

# ── App overrides (optional) ─────────────────────────────────────────────────
# SQLWHISPER_APP__MAX_ROWS="500"
# SQLWHISPER_APP__MAX_RETRIES="3"
# SQLWHISPER_APP__MAX_TABLES_IN_PROMPT="5"
