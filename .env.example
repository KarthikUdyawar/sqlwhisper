# Ollama (external instance: host, LAN or another compose project)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=60

# Query limits
MAX_ROWS=500
MAX_RETRIES=2
QUERY_TIMEOUT_S=15

# Uploads and storage
MAX_UPLOAD_MB=50
DATA_DIR=./data

# UI -> API
API_URL=http://localhost:8000

# Docker Compose only: Ollama URL as seen from the api container.
# Default joins the ollama-hub network. Use a LAN URL if Ollama is elsewhere.
# DOCKER_OLLAMA_URL=http://ollama:11434
