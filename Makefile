.RECIPEPREFIX := >
.PHONY: check lint type test tags smoke tree

check: lint type test

lint:
> uv run ruff check . && uv run ruff format --check .

type:
> uv run mypy src tests

test:
> uv run pytest -m "not ollama"

tags:
> curl -s $${OLLAMA_URL:-http://localhost:11434}/api/tags | jq .

smoke:
> uv run pytest -m ollama -s

tree:
> @command -v tree >/dev/null || { echo 'Install tree: sudo apt install tree'; exit 1; }
> @{ printf '# SQLWhisper: Repository Structure\n\nGenerated by make tree. Do not edit manually.\n\n\140\140\140text\n'; \
>   tree -a --gitignore --dirsfirst --noreport -I '.git|.venv|__pycache__|.mypy_cache|.ruff_cache|.pytest_cache'; \
>   printf '\140\140\140\n'; } > docs/STRUCTURE.md
> @echo "Generated docs/STRUCTURE.md"
